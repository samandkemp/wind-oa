#version 450
// Pass 2: one ray per pixel, front to back with a running transmittance,
// compositing the model surface (its mesh -- the distance and normal per
// pixel from the raster pass, THEORY 10.10 -- or the solver's cells as
// voxels or smoothed; optionally Cp-painted),
// an opaque slice plane, Q-criterion vortex cores, dye smoke, the field
// haze, the mean reversed-flow region and the tunnel box edges.
// The surface can be painted with Cp, the near-wall speed, the near-wall
// streamwise direction (reversed flow) or oil-flow streaks, and the slice
// can carry a line-integral-convolution texture of its in-plane flow
// (THEORY 10.7, 10.8).
// Also writes each pixel's depth (ray distance to the first opaque hit,
// 1e30 if none) so the smoke / streamline splats can be depth-tested.
//
// Transfer function: opacity from deviation from the freestream above a
// noise floor, so undisturbed flow is transparent (without it the tunnel
// renders as a block of fog). Cost scales with pixels, not flow.
//
// Output: packed RGBA8 per pixel, row 0 at the top (Vulkan image order).
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
#include "vol_common.glsl"

const int SURFACE_HIDDEN = 0;
const int SURFACE_VOXEL = 1;
const int SURFACE_SMOOTH = 2;
const int SURFACE_MESH = 3;
const float SOLID_SUBSTEP = 0.5;
// The background: a gentle gradient, darker below.
const vec3 BACKGROUND_LOW = vec3(0.025, 0.027, 0.045);
const vec3 BACKGROUND_HIGH = vec3(0.080, 0.088, 0.135);

// Feature bits in P.img.z
const int F_BOX = 1;
const int F_HAZE = 2;
const int F_PAINT_CP = 4;
const int F_Q = 8;
const int F_DYE = 16;
const int F_DYE_BY_SPEED = 32;
const int F_RECIRC = 64;     // mean reversed-flow shells (needs t_recirc)
const int F_SLICE_LIC = 128; // LIC texture on the slice
const int F_SKIP = 2048;     // step over empty blocks (no dye, cores or shells drawn)

// Surface paint (P.img.w >> 4), with F_PAINT_CP as the on switch
const int PAINT_CP = 0;
const int PAINT_WALL_SPEED = 1;
const int PAINT_REVERSED = 2;
const int PAINT_OIL = 3;
const float WALL_SPEED_SPAN = 1.2;  // near-wall |u_t| / U in [0, 1.2] fills the map
const int LIC_STEPS = 16;           // samples each way along a surface streak
const int LIC_SLICE_STEPS = 24;     // and along a slice streak (cheap: no normals)
const float DYE_SPEED_SPAN = 1.5;  // dye colour spans |u| / U in [0, 1.5]

// 128 bytes -- the guaranteed push-constant minimum; all vec4 (std430-safe).
layout(push_constant) uniform Params {
    ivec4 dims;   // nx, ny, nz, n_steps
    ivec4 img;    // width, height, feature bits, surface | paint << 4
    ivec4 modes;  // cmode, slice_axis (-1 = none), pscale, LIC phase (float bits)
    vec4 eye;     // xyz, tan(fov / 2)
    vec4 fwd;     // xyz, aspect
    vec4 right;   // xyz, u_ref
    vec4 up;      // xyz, rho_ref (Euler: p_ref)
    vec4 haze;    // gain, floor, slice_pos (0..1), dye_gain
} P;

layout(std430, binding = 0) readonly buffer Flags { uint flags[]; };
layout(std430, binding = 1) readonly buffer Macro { vec4 macro[]; };
// Volume quantities as 3-D textures (Image3D): hardware trilinear filtering,
// one fetch per sample from 3-D-tiled memory (8 scattered buffer loads per
// sample before). Extent (nz, ny, nx): sampled at p.zyx / N.zyx.
layout(binding = 2) uniform sampler3D t_field;
layout(std430, binding = 3) readonly buffer Occ { uint occ[]; };
layout(binding = 4) uniform sampler3D t_raw;
layout(binding = 5) uniform sampler3D t_blur;
layout(binding = 6) uniform sampler3D t_q;
layout(std430, binding = 7) readonly buffer QStat { vec4 qstat; };  // threshold, rms, n
layout(binding = 8) uniform sampler3D t_dye;
layout(std430, binding = 9) writeonly buffer Image { uint image[]; };
layout(std430, binding = 10) writeonly buffer Depth { float depth[]; };
layout(binding = 11) uniform sampler3D t_speed;  // |u| per cell
layout(binding = 12) uniform sampler3D t_recirc;  // <u_x> / U per cell (F_RECIRC)
// SURFACE_MESH: per pixel the mesh's normal and the distance to it (1e30: none)
layout(std430, binding = 13) readonly buffer Surf { vec4 surf[]; };
// F_SKIP: blocks where the haze can show, and macro blocks with anything to
// draw (vol_active.comp)
layout(std430, binding = 14) readonly buffer Active { uint block_active[]; };
layout(std430, binding = 15) readonly buffer MacroBusy { uint macro_busy[]; };

// Distance along d from eye to where it leaves the box [lo, lo + size).
float box_exit(vec3 eye, vec3 d, vec3 lo, float size) {
    float t = 1e30;
    for (int k = 0; k < 3; ++k) {
        if (d[k] > 1e-9) t = min(t, (lo[k] + size - eye[k]) / d[k]);
        else if (d[k] < -1e-9) t = min(t, (lo[k] - eye[k]) / d[k]);
    }
    return t;
}

ivec3 N;

// -- colour maps ------------------------------------------------------------------
vec3 coolwarm(float t) {
    const float tc = clamp(t, 0.0, 1.0);
    return tc <= 0.5 ? vec3(2.0 * tc, 2.0 * tc, 1.0) : vec3(1.0, 2.0 * (1.0 - tc), 2.0 * (1.0 - tc));
}

vec3 vortmap(float t) {
    const float tc = clamp(t, 0.0, 1.0);
    const vec3 c0 = vec3(40.0, 130.0, 255.0) / 255.0;
    const vec3 c1 = vec3(10.0, 30.0, 90.0) / 255.0;
    const vec3 c2 = vec3(3.0, 4.0, 8.0) / 255.0;
    const vec3 c3 = vec3(110.0, 25.0, 20.0) / 255.0;
    const vec3 c4 = vec3(255.0, 140.0, 40.0) / 255.0;
    if (tc < 0.3) return mix(c0, c1, tc / 0.3);
    if (tc < 0.5) return mix(c1, c2, (tc - 0.3) / 0.2);
    if (tc < 0.7) return mix(c2, c3, (tc - 0.5) / 0.2);
    return mix(c3, c4, (tc - 0.7) / 0.3);
}

// Sequential maps (dye, vortex cores)
vec3 dyemap(float t) {
    const float tc = clamp(t, 0.0, 1.0);
    const vec3 c0 = vec3(0.20, 0.07, 0.42), c1 = vec3(0.66, 0.13, 0.46);
    const vec3 c2 = vec3(0.98, 0.45, 0.18), c3 = vec3(1.00, 0.93, 0.62);
    if (tc < 0.35) return mix(c0, c1, tc / 0.35);
    if (tc < 0.65) return mix(c1, c2, (tc - 0.35) / 0.30);
    return mix(c2, c3, (tc - 0.65) / 0.35);
}

vec3 qcoremap(float t) {
    return mix(vec3(0.30, 0.95, 0.50), vec3(0.85, 0.55, 0.30), clamp(t, 0.0, 1.0));
}

// A sequential map with even lightness steps (after matplotlib's viridis).
vec3 seqmap(float t) {
    const float tc = clamp(t, 0.0, 1.0);
    const vec3 c0 = vec3(0.267, 0.005, 0.329), c1 = vec3(0.229, 0.322, 0.546);
    const vec3 c2 = vec3(0.128, 0.567, 0.551), c3 = vec3(0.369, 0.789, 0.383);
    const vec3 c4 = vec3(0.993, 0.906, 0.144);
    if (tc < 0.25) return mix(c0, c1, tc / 0.25);
    if (tc < 0.5) return mix(c1, c2, (tc - 0.25) / 0.25);
    if (tc < 0.75) return mix(c2, c3, (tc - 0.5) / 0.25);
    return mix(c3, c4, (tc - 0.75) / 0.25);
}

int palette;          // 0: each field's own map (P.img.z bits 8 - 9)
bool magnitude_field;  // P.img.z bit 10: a magnitude from zero (|vorticity|, schlieren, turbulence)
vec3 fieldcolour(float sv, int cmode) {
    if (palette > 0) {  // a signed field spans the map about its middle, a magnitude from zero
        const float tp =
            magnitude_field ? clamp(sv, 0.0, 1.0) : 0.5 + 0.5 * clamp(sv, -1.0, 1.0);
        if (palette == 1) return seqmap(tp);
        if (palette == 2) return coolwarm(tp);
        return vec3(0.88, 0.92, 1.0) * tp;
    }
    const float t = 0.5 + 0.5 * clamp(sv, -1.0, 1.0);
    if (cmode == CMODE_VORT) return vortmap(t);
    if (cmode == CMODE_GREY) return vec3(0.88, 0.92, 1.0) * clamp(sv, 0.0, 1.0);
    if (cmode == CMODE_SEQ) return dyemap(clamp(sv, 0.0, 1.0));
    return coolwarm(t);
}

// -- sampling -----------------------------------------------------------------
ivec3 cell_of(vec3 p) { return ivec3(clamp(p, vec3(0.0), vec3(N - 1))); }

bool is_solid_cell(ivec3 c) { return flags[cell_index(c.x, c.y, c.z, N)] != FLUID; }

// Trilinear sample of a cell-centred scalar (nearest-cell looks blocky).
// `which`: 0 field, 1 solid_raw, 2 solid_blur, 3 Q, 4 dye, 5 |u|, 6 <u_x> / U (GLSL
// cannot pass a buffer as an argument).
float trilinear(int which, vec3 p) {
    // hardware trilinear; clamp-to-edge = the old clamp of p - 1/2 to [0, N - 1]
    const vec3 uvw = p.zyx / vec3(N.zyx);
    switch (which) {
    case 0: return textureLod(t_field, uvw, 0.0).r;
    case 1: return textureLod(t_raw, uvw, 0.0).r;
    case 2: return textureLod(t_blur, uvw, 0.0).r;
    case 3: return textureLod(t_q, uvw, 0.0).r;
    case 4: return textureLod(t_dye, uvw, 0.0).r;
    case 6: return textureLod(t_recirc, uvw, 0.0).r;
    default: return textureLod(t_speed, uvw, 0.0).r;
    }
}

// Trilinear rho over FLUID cells only (weights renormalised): solid cells
// hold a stale density and would bias the surface Cp.
float fluid_trilinear_rho(vec3 p, float fallback) {
    const vec3 g = clamp(p - 0.5, vec3(0.0), vec3(N) - 1.001);
    const ivec3 i0 = ivec3(g);
    const vec3 t = g - vec3(i0);
    float acc = 0.0, wsum = 0.0;
    for (int dx = 0; dx < 2; ++dx)
        for (int dy = 0; dy < 2; ++dy)
            for (int dz = 0; dz < 2; ++dz) {
                const uint c = cell_index(i0.x + dx, i0.y + dy, i0.z + dz, N);
                if (flags[c] == FLUID) {
                    const float w = (dx == 1 ? t.x : 1.0 - t.x) * (dy == 1 ? t.y : 1.0 - t.y) *
                                    (dz == 1 ? t.z : 1.0 - t.z);
                    acc += w * macro[c].w;
                    wsum += w;
                }
            }
    return wsum > 1e-6 ? acc / wsum : fallback;
}

// Voxel normal: 3x3x3 weighted pull towards fluid neighbours (a 6-neighbour
// difference shades every voxel step as a hard facet).
vec3 voxel_normal(vec3 p) {
    const ivec3 c = cell_of(p);
    vec3 n = vec3(0.0);
    for (int ox = -1; ox <= 1; ++ox)
        for (int oy = -1; oy <= 1; ++oy)
            for (int oz = -1; oz <= 1; ++oz) {
                if (ox == 0 && oy == 0 && oz == 0) continue;
                const ivec3 q = clamp(c + ivec3(ox, oy, oz), ivec3(0), N - 1);
                if (!is_solid_cell(q)) n += vec3(ox, oy, oz) * inversesqrt(float(ox * ox + oy * oy + oz * oz));
            }
    return length(n) < 1e-6 ? vec3(0.0, 1.0, 0.0) : normalize(n);
}

// Smooth normal: -grad of the blurred indicator (central, +-0.75 cells).
vec3 smooth_normal(vec3 p) {
    const float h = 0.75;
    const vec3 g = vec3(trilinear(2, p + vec3(h, 0, 0)) - trilinear(2, p - vec3(h, 0, 0)),
                        trilinear(2, p + vec3(0, h, 0)) - trilinear(2, p - vec3(0, h, 0)),
                        trilinear(2, p + vec3(0, 0, h)) - trilinear(2, p - vec3(0, 0, h)));
    return length(g) < 1e-6 ? vec3(0.0, 1.0, 0.0) : normalize(-g);
}

// Trilinear velocity over FLUID cells only (solid cells hold stale values).
vec3 fluid_trilinear_u(vec3 p) {
    const vec3 g = clamp(p - 0.5, vec3(0.0), vec3(N) - 1.001);
    const ivec3 i0 = ivec3(g);
    const vec3 t = g - vec3(i0);
    vec3 acc = vec3(0.0);
    float wsum = 0.0;
    for (int dx = 0; dx < 2; ++dx)
        for (int dy = 0; dy < 2; ++dy)
            for (int dz = 0; dz < 2; ++dz) {
                const uint c = cell_index(i0.x + dx, i0.y + dy, i0.z + dz, N);
                if (flags[c] == FLUID) {
                    const float w = (dx == 1 ? t.x : 1.0 - t.x) * (dy == 1 ? t.y : 1.0 - t.y) *
                                    (dz == 1 ? t.z : 1.0 - t.z);
                    acc += w * macro[c].xyz;
                    wsum += w;
                }
            }
    return wsum > 1e-6 ? acc / wsum : vec3(0.0);
}

// White noise on a lattice of spacing 1 / freq: the texture a line-integral
// convolution smears along the flow.
float lic_noise(vec3 p, float freq) {
    const ivec3 c = ivec3(floor(p * freq));
    uint h = uint(c.x) * 73856093u ^ uint(c.y) * 19349663u ^ uint(c.z) * 83492791u;
    h = h * 747796405u + 2891336453u;
    h = ((h >> ((h >> 28u) + 4u)) ^ h) * 277803737u;
    return float((h >> 22u) ^ h) * (1.0 / 4294967296.0);
}

// The flow along the surface at p: the velocity one cell out along the
// normal, with its normal component removed (THEORY 10.7).
vec3 wall_flow(vec3 p, vec3 nrm) {
    const vec3 u = fluid_trilinear_u(p + nrm);
    return u - dot(u, nrm) * nrm;
}

// Animated flow textures (the periodic motion filter of Cabral & Leedom
// 1993): the samples along a streak are weighted by a ripple at arc length s
// whose phase advances every frame, so the texture travels downstream with
// the flow. A negative phase leaves the still texture exactly as it was.
float lic_phase;
float ripple(float s, float period) {
    if (lic_phase < 0.0) return 1.0;
    return 0.3 + 0.35 * (1.0 + cos(6.2831853 * (s / period - lic_phase)));
}

// Oil-flow streaks: the noise averaged along the near-wall flow over the
// surface (a tent filter), so streaks follow the skin-friction lines and
// break up where the flow separates or stalls.
float surface_lic(vec3 p0, vec3 n0, float freq) {
    const float h = 0.35 / freq, period = float(LIC_STEPS) * h;
    const float r0 = ripple(0.0, period);
    float acc = r0 * lic_noise(p0, freq), wsum = r0;
    for (int dir = -1; dir <= 1; dir += 2) {
        vec3 p = p0, nrm = n0;
        for (int k = 1; k <= LIC_STEPS; ++k) {
            const vec3 ut = wall_flow(p, nrm);
            const float s = length(ut);
            if (s < 1e-7) break;
            p += float(dir) * h * ut / s;
            nrm = smooth_normal(p);
            const float w = (1.0 - float(k) / float(LIC_STEPS + 1)) *
                            ripple(float(dir * k) * h, period);
            acc += w * lic_noise(p, freq);
            wsum += w;
        }
    }
    return acc / wsum;
}

// The same along the slice's in-plane flow (axis = the slice normal).
float slice_lic(vec3 p0, int axis, float freq) {
    const float h = 0.35 / freq, period = float(LIC_SLICE_STEPS) * h;
    const float r0 = ripple(0.0, period);
    float acc = r0 * lic_noise(p0, freq), wsum = r0;
    for (int dir = -1; dir <= 1; dir += 2) {
        vec3 p = p0;
        for (int k = 1; k <= LIC_SLICE_STEPS; ++k) {
            vec3 u = fluid_trilinear_u(p);
            u[axis] = 0.0;
            const float s = length(u);
            if (s < 1e-7) break;
            p += float(dir) * h * u / s;
            if (any(lessThan(p, vec3(0.0))) || any(greaterThanEqual(p, vec3(N))) ||
                is_solid_cell(cell_of(p)))
                break;
            const float w = (1.0 - float(k) / float(LIC_SLICE_STEPS + 1)) *
                            ripple(float(dir * k) * h, period);
            acc += w * lic_noise(p, freq);
            wsum += w;
        }
    }
    return acc / wsum;
}

// Lighting (THEORY 10.10): a key light from above to one side, a fill from
// the eye, a rim on the silhouette and a soft glint, all dimmed by the
// solid close round the point (corners, under the body, at the floor).
const vec3 KEY_LIGHT = vec3(0.4, 0.8, 0.45) / length(vec3(0.4, 0.8, 0.45));

// The solid fraction a little way out from the surface: 1 in the open,
// less where the model or the floor closes round the point.
float occlusion(vec3 p, vec3 n) {
    const vec3 a = normalize(abs(n.y) < 0.9 ? cross(n, vec3(0.0, 1.0, 0.0))
                                            : cross(n, vec3(1.0, 0.0, 0.0)));
    const vec3 b = cross(n, a);
    const vec3 q = p + 2.0 * n;
    const float s = trilinear(1, q + 2.0 * a) + trilinear(1, q - 2.0 * a) +
                    trilinear(1, q + 2.0 * b) + trilinear(1, q - 2.0 * b) +
                    2.0 * trilinear(1, p + 3.5 * n);
    return clamp(1.0 - 0.5 * s, 0.4, 1.0);
}

// `base` lit at p with normal n seen along d; `glint` scales the highlight
// (lower on painted surfaces, so their colours read).
vec3 shade(vec3 base, vec3 n, vec3 d, vec3 p, float glint) {
    const float ndl = max(dot(n, KEY_LIGHT), 0.0);
    const float fill = max(dot(n, -d), 0.0);
    const float rim = 1.0 - abs(dot(n, d));
    const float ao = occlusion(p, n);
    const float diff = (0.24 + 0.52 * ndl + 0.26 * fill) * ao + 0.14 * rim * rim;
    const vec3 h = normalize(KEY_LIGHT - d);
    const float spec = glint * pow(max(dot(n, h), 0.0), 48.0) * ao;
    return base * diff + vec3(spec);
}

// Contrast of a LIC average (white noise averaged over ~LIC_STEPS samples
// has a narrow spread about 1/2), mapped to a brightness factor.
float lic_shade(float l) {
    return clamp(0.5 + 2.6 * (l - 0.5), 0.0, 1.0);
}

// Noise frequency for a grain about three pixels wide at distance t.
float lic_freq(float t, float tan_half, int height) {
    const float px = 2.0 * t * tan_half / float(height); // cells per pixel
    return clamp(0.33 / max(px, 1e-4), 0.5, 4.0);
}

void main() {
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    const int W = P.img.x, H = P.img.y;
    if (px.x >= W || px.y >= H) return;  // no barrier() in this kernel
    N = P.dims.xyz;
    lic_phase = intBitsToFloat(P.modes.w);
    palette = (P.img.z >> 8) & 3;
    magnitude_field = ((P.img.z >> 10) & 1) != 0;
    const int n_steps = P.dims.w;
    const int feat = P.img.z;
    const bool show_box = (feat & F_BOX) != 0, show_haze = (feat & F_HAZE) != 0;
    const bool paint_cp = (feat & F_PAINT_CP) != 0;
    const bool show_q = (feat & F_Q) != 0, show_dye = (feat & F_DYE) != 0;
    const bool dye_by_speed = (feat & F_DYE_BY_SPEED) != 0;
    const int surface = P.img.w & 15, paint_mode = P.img.w >> 4;
    const int cmode = P.modes.x, slice_axis = P.modes.y;
    const bool show_recirc = (feat & F_RECIRC) != 0, slice_tex = (feat & F_SLICE_LIC) != 0;
    const float pscale = intBitsToFloat(P.modes.z);
    const float dye_gain = P.haze.w;
    const float q_thresh = show_q ? qstat.x : 1e30;
    const vec3 eye = P.eye.xyz;
    const float tan_half = P.eye.w, aspect = P.fwd.w;
    const float u_ref = P.right.w, rho_ref = P.up.w;
    const float haze_gain = P.haze.x, haze_floor = P.haze.y, slice_pos = P.haze.z;
    const float inv_q = 1.0 / max(0.5 * u_ref * u_ref, 1e-12);
    const vec3 dims = vec3(N);
    const ivec3 nb = (N + OCC_BLOCK - 1) / OCC_BLOCK;
    const ivec3 nm = (nb + MACRO_BLOCK - 1) / MACRO_BLOCK;

    const float u = (2.0 * (float(px.x) + 0.5) / float(W) - 1.0) * tan_half * aspect;
    const float v = (1.0 - 2.0 * (float(px.y) + 0.5) / float(H)) * tan_half;  // row 0 = top
    const vec3 d = normalize(P.fwd.xyz + u * P.right.xyz + v * P.up.xyz);

    // Slab-intersect the tunnel box: march only inside it.
    float t_near = 0.0, t_far = 1e18;
    bool hit_box = true;
    for (int k = 0; k < 3; ++k) {
        if (abs(d[k]) < 1e-9) {
            if (eye[k] < 0.0 || eye[k] > dims[k]) hit_box = false;
        } else {
            float ta = -eye[k] / d[k], tb = (dims[k] - eye[k]) / d[k];
            if (ta > tb) { const float s = ta; ta = tb; tb = s; }
            t_near = max(t_near, ta);
            t_far = min(t_far, tb);
        }
    }

    vec3 acc = vec3(0.0);
    float trans = 1.0;
    float hit_t = 1e30;
    const bool mesh_surface = surface == SURFACE_MESH;
    const vec4 mesh_px = mesh_surface ? surf[px.y * W + px.x] : vec4(0.0, 1.0, 0.0, 1e30);
    const float t_mesh = mesh_px.w;

    if (hit_box && t_far > t_near) {
        if (show_box) {  // an edge is where two coordinates sit on a box face
            const vec3 pe = eye + d * t_near;
            int on_face = 0;
            for (int k = 0; k < 3; ++k)
                if (abs(pe[k]) < 0.9 || abs(pe[k] - dims[k]) < 0.9) ++on_face;
            if (on_face >= 2) {
                acc += 0.55 * vec3(0.55, 0.57, 0.62);
                trans *= 0.45;
            }
        }

        const float dt = (t_far - t_near) / float(n_steps);
        // Fixed per-pixel start offset: in-phase rays drew "wood-grain"
        // bands one step apart; dithered, they become fine grain.
        const float jit = fract(sin(float(px.x) * 12.9898 + float(px.y) * 78.233) * 43758.5453);
        const float t_start = t_near + jit * dt;
        // Empty-space skipping (THEORY 10.11): a block with no solid near it
        // and no haze above its floor adds nothing, so the march jumps to its
        // first sample beyond the block -- the same sample positions -- but
        // never past the mesh's hit or into the slice's band.
        const bool skip = (feat & F_SKIP) != 0;
        float t_limit = t_mesh;
        if (skip && slice_axis >= 0) {
            const float da = d[slice_axis];
            const float band = 0.6 * dt + 0.35;
            const float off = slice_pos * dims[slice_axis] - eye[slice_axis];
            if (abs(da) > 1e-6) {
                const float t_band = off / da - band / abs(da);
                if (off / da + band / abs(da) > t_near) // the band lies ahead
                    t_limit = min(t_limit, t_band);
            } else if (abs(off) < band) {
                t_limit = -1e30; // along the slice, inside its band: no skipping
            }
        }
        for (int step = 0; step < n_steps; ++step) {
            if (trans < 0.01) break;
            float t = t_start + float(step) * dt;
            vec3 p = eye + d * t;
            const ivec3 ci = cell_of(p);
            const ivec3 bi = ci / OCC_BLOCK;
            const uint bidx = uint((bi.x * nb.y + bi.y) * nb.z + bi.z);
            if (skip && t < t_limit) {
                // a whole macro block when nothing in it is busy, else this block
                const ivec3 mi = bi / MACRO_BLOCK;
                float t_exit = -1.0;
                if (macro_busy[(mi.x * nm.y + mi.y) * nm.z + mi.z] == 0u)
                    t_exit = box_exit(eye, d, vec3(mi * (MACRO_BLOCK * OCC_BLOCK)),
                                      float(MACRO_BLOCK * OCC_BLOCK));
                else if (occ[bidx] != 1u && !(show_haze && block_active[bidx] != 0u))
                    t_exit = box_exit(eye, d, vec3(bi * OCC_BLOCK), float(OCC_BLOCK));
                if (t_exit > t) {
                    const int m = int(floor((min(t_exit, t_limit) - t) / dt)) + 1;
                    if (m > 1) {
                        step += m - 1; // the loop adds the last
                        continue;
                    }
                }
            }
            bool solid = false;
            if (occ[bidx] == 1u) {
                // Near geometry: re-walk this step finely from the previous
                // sample so a surface is hit where it is and a 1-cell part
                // cannot be stepped over.
                const float t0 = max(t - dt, t_near);
                const int nsub = max(1, int(ceil((t - t0) / SOLID_SUBSTEP)));
                if (surface == SURFACE_SMOOTH) {
                    // first crossing of the indicator's 1/2 level, refined by
                    // a secant step between substeps
                    float v0 = trilinear(1, eye + d * t0);
                    float tprev = t0;
                    for (int k = 1; k <= nsub; ++k) {
                        const float tt = t0 + (t - t0) * float(k) / float(nsub);
                        const float v1 = trilinear(1, eye + d * tt);
                        if (v1 >= 0.5) {
                            const float f = v1 - v0 > 1e-6 ? clamp((0.5 - v0) / (v1 - v0), 0.0, 1.0) : 0.0;
                            t = tprev + (tt - tprev) * f;
                            p = eye + d * t;
                            solid = true;
                            break;
                        }
                        v0 = v1;
                        tprev = tt;
                    }
                } else { // voxels; with the mesh, only the floor and walls
                    for (int k = 1; k <= nsub; ++k) {
                        const float tt = t0 + (t - t0) * float(k) / float(nsub);
                        const vec3 pp = eye + d * tt;
                        const uint f = flags[cell_index(cell_of(pp).x, cell_of(pp).y,
                                                        cell_of(pp).z, N)];
                        if (f != FLUID && !(mesh_surface && f == 1u)) {
                            solid = true;
                            t = tt;
                            p = pp;
                            break;
                        }
                    }
                }
            }

            // The mesh, where it comes first along the ray (the floor, met
            // above, may still be nearer).
            bool mesh_hit = false;
            if (mesh_surface && t_mesh <= t) {
                solid = true;
                mesh_hit = true;
                t = max(t_mesh, t_near);
                p = eye + d * t;
            }

            if (solid) {
                if (surface != SURFACE_HIDDEN) {
                    const vec3 nrm = mesh_hit                     ? mesh_px.xyz
                                     : surface == SURFACE_VOXEL ? voxel_normal(p)
                                                                : smooth_normal(p);
                    // The model (OBSTACLE) is painted; a floor / belt / wall
                    // is plain darker grey, so it does not read as part of it.
                    const uint hit_flag = flags[cell_index(cell_of(p + 0.5 * d).x, cell_of(p + 0.5 * d).y,
                                                           cell_of(p + 0.5 * d).z, N)];
                    const bool model_cell = mesh_hit || hit_flag == 1u || hit_flag == FLUID;
                    vec3 base = model_cell ? vec3(0.80, 0.81, 0.84) : vec3(0.36, 0.37, 0.41);
                    float glint = model_cell ? 0.22 : 0.08;
                    if (paint_cp && model_cell && paint_mode == PAINT_CP) {
                        // Pressure over FLUID cells only (the single last fluid
                        // cell striped every voxel staircase): half a cell back
                        // along the ray from the cells, a cell out along the
                        // normal from the mesh (it sits up to a cell off them).
                        const vec3 ps = mesh_hit ? p + 0.75 * nrm : p - d * (0.5 + 0.5 * dt);
                        // (no fluid cell in reach, as deep in a crevice: Cp 0)
                        const float rho_s = fluid_trilinear_rho(ps, rho_ref);
                        const float cp = (rho_s - rho_ref) * pscale * inv_q;
                        base = coolwarm(0.5 + 0.5 * clamp(cp, -1.0, 1.0));
                        glint = 0.10;
                    } else if (paint_cp && model_cell) {
                        // Near-wall flow, from the smooth normal whatever the
                        // surface style (a voxel normal is a staircase).
                        const vec3 sn = mesh_hit ? nrm : smooth_normal(p);
                        const vec3 ut = wall_flow(p, sn);
                        glint = 0.10;
                        if (paint_mode == PAINT_WALL_SPEED) {
                            base = dyemap(length(ut) / (WALL_SPEED_SPAN * max(u_ref, 1e-9)));
                        } else if (paint_mode == PAINT_REVERSED) {
                            base = coolwarm(0.5 + 0.5 * clamp(ut.x / (0.5 * max(u_ref, 1e-9)), -1.0, 1.0));
                        } else {  // oil flow: pale streaks on a mid-grey film
                            const float l = surface_lic(p, sn, lic_freq(t, tan_half, H));
                            const float k = clamp(0.5 + 1.8 * (l - 0.5), 0.0, 1.0);
                            const vec3 ground = vec3(0.30, 0.31, 0.34), streak = vec3(0.95, 0.94, 0.88);
                            base = mix(ground, streak, k);
                        }
                    }
                    acc += trans * shade(base, nrm, d, p, glint);
                    trans = 0.0;
                    hit_t = t;
                    break;
                }
            } else {
                if (slice_axis >= 0) {  // an opaque cut
                    if (abs(p[slice_axis] - slice_pos * dims[slice_axis]) < 0.6 * dt + 0.35) {
                        vec3 scol = fieldcolour(trilinear(0, p), cmode);
                        if (slice_tex) {
                            vec3 ps = p;
                            ps[slice_axis] = slice_pos * dims[slice_axis];
                            const float l = lic_shade(slice_lic(ps, slice_axis, lic_freq(t, tan_half, H)));
                            scol *= 0.45 + 0.75 * l;
                        }
                        acc += trans * scol;
                        trans = 0.0;
                        hit_t = t;
                        break;
                    }
                }

                float dens = 0.0;
                vec3 col = vec3(0.0);

                if (show_q) {  // vortex cores: translucent shells
                    const float qv = trilinear(3, p);
                    if (qv > q_thresh) {
                        const float shell =
                            clamp((qv - q_thresh) / max(3.0 * q_thresh, 1e-20), 0.0, 1.0);
                        const float w = 3.0 * (0.35 + 0.65 * shell);
                        dens += w;
                        col += w * qcoremap(shell);
                    }
                }

                if (show_recirc) {  // the mean flow runs backwards: translucent teal shells
                    const float ur = trilinear(6, p);
                    if (ur < 0.0) {
                        const float k = clamp(-ur / 0.3, 0.0, 1.0);
                        const float w = 2.5 * (0.35 + 0.65 * k);
                        dens += w;
                        col += w * mix(vec3(0.25, 0.75, 0.85), vec3(0.10, 0.35, 0.95), k);
                    }
                }

                if (show_dye) {  // concentration -> opacity; white or by speed
                    const float cd = trilinear(4, p);
                    if (cd > 0.002) {
                        const float w = dye_gain * min(cd, 1.2);
                        const vec3 dcol =
                            dye_by_speed ? dyemap(trilinear(5, p) / (DYE_SPEED_SPAN * max(u_ref, 1e-9)))
                                         : vec3(0.90, 0.92, 0.96);
                        dens += w;
                        col += w * dcol;
                    }
                }

                if (show_haze) {
                    const float sv = trilinear(0, p);
                    // schlieren / Mach: magnitude above the floor only
                    const float dev = cmode >= CMODE_GREY ? sv - haze_floor : abs(sv) - haze_floor;
                    if (dev > 0.0) {
                        const float hd = haze_gain * min(dev, 3.0);
                        dens += hd;
                        col += hd * fieldcolour(sv, cmode);
                    }
                }

                if (dens > 1e-6) {  // density-weighted colour
                    const float alpha = 1.0 - exp(-dens * dt * 0.08);
                    acc += trans * alpha * (col / dens);
                    trans *= 1.0 - alpha;
                }
            }
        }
    }

    const vec3 background = mix(BACKGROUND_LOW, BACKGROUND_HIGH, clamp(0.5 + 0.5 * v / tan_half, 0.0, 1.0));
    image[px.y * W + px.x] = packUnorm4x8(vec4(acc + trans * background, 1.0));
    depth[px.y * W + px.x] = hit_t;
}
