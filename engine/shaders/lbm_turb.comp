#version 450
// Synthetic inlet turbulence, as a post-step overwrite of the inlet plane.
// The step kernel writes x = 0 as pure equilibrium at (1, u_in) and nothing
// else there, so replacing it with (1, u_in + frac u_in u') is exactly a
// turbulent Dirichlet inlet without
// touching the hot kernel. u' is read from a periodic, divergence-free
// patch at stream position `phase` (Taylor's frozen turbulence), linearly
// interpolated between its planes. Specification: THEORY 7.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 256) in;
layout(constant_id = 0) const bool F16 = false;
#include "lattice.glsl"
#include "lbm_params.glsl"  // aux = (phase, intensity, span, -)

layout(std430, binding = 0) writeonly buffer FDst { float f_dst[]; };
layout(std430, binding = 0) writeonly buffer FDst16 { float16_t f_dst16[]; };
layout(std430, binding = 1) readonly buffer Flags { uint flags[]; };
layout(std430, binding = 2) writeonly buffer MacroOut { vec4 macro_out[]; };
layout(std430, binding = 3) readonly buffer Patch { vec4 patch_[]; };  // [s][y][z] u'

void main() {
    const ivec3 n = P.dims.xyz;
    const uint N = uint(n.x * n.y * n.z);
    const uint j = gl_GlobalInvocationID.x;  // y * nz + z on the x = 0 plane
    if (j >= uint(n.y * n.z)) return;
    const uint c = j;  // cell_index(0, y, z) == y * nz + z
    if (flags[c] != FLUID) return;
    const float phase = P.aux.x;
    const int span = int(P.aux.z);
    const int i0 = int(floor(phase)) % span;
    const int i1 = (i0 + 1) % span;
    const float fr = phase - floor(phase);
    const vec3 du = (1.0 - fr) * patch_[uint(i0) * uint(n.y * n.z) + j].xyz +
                    fr * patch_[uint(i1) * uint(n.y * n.z) + j].xyz;
    const float u0 = P.flow.x;
    const vec3 u = vec3(u0, 0.0, 0.0) + P.aux.y * u0 * du;
    for (int i = 0; i < Q; ++i) {
        if (F16) f_dst16[uint(i) * N + c] = float16_t(feq(i, 1.0, u) - W[i]);
        else f_dst[uint(i) * N + c] = feq(i, 1.0, u);
    }
    macro_out[c] = vec4(u, 1.0);
}
