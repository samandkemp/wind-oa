#version 450
// rho and u recomputed as moments of f for FLUID cells (incl. the Guo half-
// force shift). Needed after anything writes the distributions directly
// (set_state): the pressure outlet reads the previous step's u, and a
// stale u launches a pressure pulse up the tunnel (V23).
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 256) in;
layout(constant_id = 0) const bool F16 = false;
#include "lattice.glsl"
#include "lbm_params.glsl"

layout(std430, binding = 0) readonly buffer F { float f[]; };
layout(std430, binding = 0) readonly buffer F16v { float16_t f16[]; };
layout(std430, binding = 1) readonly buffer Flags { uint flags[]; };
layout(std430, binding = 2) writeonly buffer Macro { vec4 macro[]; };

void main() {
    const ivec3 n = P.dims.xyz;
    const uint N = uint(n.x * n.y * n.z);
    const uint c = linear_group() * 256u + gl_LocalInvocationID.x;
    if (c >= N || flags[c] != FLUID) return;
    float rho = 0.0;
    vec3 mom = vec3(0.0);
    for (int i = 0; i < Q; ++i) {
        const uint idx = uint(i) * N + c;
        const float fi = F16 ? float(f16[idx]) + W[i] : f[idx];
        rho += fi;
        mom += fi * vec3(E[i]);
    }
    macro[c] = vec4((mom + 0.5 * P.g.xyz) / rho, rho);
}
